set -euo pipefail

# Status of a usage error, as for git and getopt
readonly USAGE_ERROR=2

function Usage()
{
    cat <<USAGE
usage: ${0##*/} [-n | --dry-run] [-e | --equivalent] [-i | --interactive] [<commit>]

Deletes the branches merged into <commit>, by default origin/HEAD or without
it HEAD, except those
checked out in any worktree, the branch given as <commit>, the default branches
of the remotes, those matching a pattern of purge-branches.keep and those with
branch.<name>.deleteMerged set to false.

  -n, --dry-run     list the branches that would be deleted and why instead
  -e, --equivalent  also delete branches whose commits all have an equivalent
                    in <commit>, such as after a rebase on a remote
  -i, --interactive list the branches and ask before deleting them
  -h, --help        show this help
USAGE
}

declare -i dry_run=0
declare -i equivalent=0
declare -i interactive=0
positional=()

while (($# > 0)); do
    case "$1" in
        -n | --dry-run)
            dry_run=1
            ;;
        -e | --equivalent)
            equivalent=1
            ;;
        -i | --interactive)
            interactive=1
            ;;
        -h | --help)
            Usage
            exit 0
            ;;
        --)
            shift
            positional+=("$@")
            break
            ;;
        -[!-]?*)
            # Splits a bundle of short options such as -en into its first
            # option and the rest, which are parsed in turn.
            set -- "${1:0:2}" "-${1:2}" "${@:2}"
            continue
            ;;
        -*)
            echo "error: unknown option '$1'" >&2
            Usage >&2
            exit "${USAGE_ERROR}"
            ;;
        *)
            positional+=("$1")
            ;;
    esac
    shift
done

if ((${#positional[@]} > 1)); then
    echo "error: expected at most 1 commit, got ${#positional[@]}" >&2
    Usage >&2
    exit "${USAGE_ERROR}"
fi

# Branches merged into this commit are deleted. Without one, the default branch
# of origin, such as origin/main, gathers the merged work, or HEAD in a
# repository without origin/HEAD.
if ((${#positional[@]} != 0)); then
    commit="${positional[0]}"
elif git rev-parse --verify --quiet refs/remotes/origin/HEAD >/dev/null; then
    commit=origin/HEAD
else
    commit=HEAD
fi

# The branches that the remotes name as their default, such as main for
# origin/HEAD, which are always kept.
declare -i list_status=0
remote_defaults="$(git for-each-ref --format='%(symref:lstrip=3)' 'refs/remotes/*/HEAD')" ||
    list_status=$?

if ((list_status != 0)); then
    echo "error: failed to list branches, git exited with status ${list_status}" >&2
    exit "${list_status}"
fi
readarray -t default_branches <<<"${remote_defaults}"

# The glob patterns of purge-branches.keep, whose matching branches are always
# kept. git config fails with 1 if the setting is unset.
declare -i keep_status=0
keep="$(git config --get-all purge-branches.keep)" || keep_status=$?

if ((keep_status > 1)); then
    exit "${keep_status}"
fi

readarray -t keep_patterns <<<"${keep}"

# Succeeds if the branch of the given name is a default branch of a remote or
# matches a pattern of purge-branches.keep.
function IsProtected()
{
    local name="$1"
    local branch
    local pattern

    for branch in "${default_branches[@]}"; do
        if [[ -n ${branch} && ${name} == "${branch}" ]]; then
            return 0
        fi
    done

    for pattern in "${keep_patterns[@]}"; do
        # shellcheck disable=SC2053 # the pattern is a glob
        if [[ -n ${pattern} && ${name} == ${pattern} ]]; then
            return 0
        fi
    done

    return 1
}

# Stores in the array listed the full ref names of the branches that the
# for-each-ref filter given as the argument selects, except those checked out
# in any worktree, which includes the current branch, the protected ones, and
# those exempt with branch.<name>.deleteMerged set to false, as for git branch
# --delete-merged.
# Unlike the output of git branch, the format is not affected by the user's
# color or column configuration.
function ListBranches()
{
    local filter="$1"
    local -i fd
    local -i pid
    local -i status=0
    local ref
    local delete_merged
    local kept=()

    # shellcheck disable=SC2312 # wait reports the status of the substitution
    exec {fd}< <(git for-each-ref "${filter}" --omit-empty \
        --format='%(if)%(worktreepath)%(then)%(else)%(refname)%(end)' \
        refs/heads/)
    pid=$!

    readarray -u "${fd}" -t listed
    exec {fd}<&-

    wait "${pid}" || status=$?

    if ((status != 0)); then
        echo "error: failed to list branches, git exited with status ${status}" >&2
        exit "${status}"
    fi

    # git config reports a value that is not a boolean and fails, which ends
    # the script before any branch is deleted.
    for ref in "${listed[@]}"; do
        # shellcheck disable=SC2310 # the function only compares and returns
        if IsProtected "${ref#refs/heads/}"; then
            continue
        fi

        delete_merged="$(git config --type=bool --default=true \
            --get "branch.${ref#refs/heads/}.deleteMerged")"

        if [[ ${delete_merged} == true ]]; then
            kept+=("${ref}")
        fi
    done

    listed=("${kept[@]}")
}

ListBranches "--merged=${commit}"

# Every branch is merged into itself, so the list includes the branch given as
# the commit, which is kept. For the default HEAD, this is the current branch,
# which the list already omits because it is checked out. Full ref names are
# compared, since a branch may be named like the full ref of a tag, such as
# refs/tags/v1.
target="$(git rev-parse --symbolic-full-name "${commit}")"
merged=()

for ref in "${listed[@]}"; do
    if [[ ${ref} != "${target}" ]]; then
        merged+=("${ref#refs/heads/}")
    fi
done

# Branches whose commits have other hashes in the commit, such as after a
# rebase, are kept unless each of their commits has an equivalent there that
# git cherry marks with a minus. git cherry omits merge commits and matches an
# empty commit with any other, so only branches whose commits all change files
# without merging qualify.
equivalents=()

if ((equivalent)); then
    ListBranches "--no-merged=${commit}"
    declare -i commits
    declare -i changes

    for ref in "${listed[@]}"; do
        cherry="$(git cherry "${commit}" "${ref}")"
        commits="$(git rev-list --count "${commit}..${ref}")"
        changes="$(git rev-list --count --no-merges "${commit}..${ref}" -- :/)"

        # Hashes are hexadecimal, so a plus sign only marks a commit without
        # an equivalent.
        if [[ ${cherry} != *+* ]] && ((changes == commits)); then
            equivalents+=("${ref#refs/heads/}")
        fi
    done
fi

# Prints each branch to delete and the reason, separated by a tab.
function PrintCandidates()
{
    local branch

    for branch in "${merged[@]}"; do
        printf '%s\tmerged\n' "${branch}"
    done

    for branch in "${equivalents[@]}"; do
        printf '%s\tequivalent\n' "${branch}"
    done
}

if ((dry_run)); then
    PrintCandidates
    exit 0
fi

# An interactive run deletes the listed branches only if the user answers yes.
if ((interactive && ${#merged[@]} + ${#equivalents[@]} != 0)); then
    PrintCandidates
    printf 'Delete these branches? [y/N] ' >&2
    answer=
    read -r answer || true

    if [[ ${answer,,} != y && ${answer,,} != yes ]]; then
        exit 0
    fi
fi

# The commit of each branch, which restores a deleted branch
declare -A tips
tip_listing="$(git for-each-ref --format='%(refname:lstrip=2) %(objectname)' refs/heads/)"

while read -r branch tip; do
    tips["${branch}"]="${tip}"
done <<<"${tip_listing}"

declare -i status=0

if [[ ${#merged[@]} -ne 0 ]]; then
    git branch -d "${merged[@]}" || status=$?
fi

# git branch -d refuses branches that are not merged into HEAD or their
# upstream by hash.
if [[ ${#equivalents[@]} -ne 0 ]]; then
    git branch -D "${equivalents[@]}" || status=$?
fi

# Prints a command per deleted branch that restores it at its commit, since git
# branch -d names the commit only in part.
remaining="$(git for-each-ref --format='%(refname:lstrip=2)' refs/heads/)"
readarray -t remaining_branches <<<"${remaining}"
declare -A kept_branches

for branch in "${remaining_branches[@]}"; do
    kept_branches["${branch}"]=1
done

restore=()

for branch in "${merged[@]}" "${equivalents[@]}"; do
    if [[ -z ${kept_branches["${branch}"]:-} ]]; then
        restore+=("git branch ${branch} ${tips["${branch}"]}")
    fi
done

if ((${#restore[@]} != 0)); then
    echo "Restore the deleted branches with:"
    printf '%s\n' "${restore[@]}"
fi

exit "${status}"
